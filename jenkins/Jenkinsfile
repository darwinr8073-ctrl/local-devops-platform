
pipeline {
    agent any

    environment {
        APP_IMAGE = 'local-devops-app:1.0'
    }

    stages {
        stage('Checkout') {
            steps {
                echo 'Starting Local DevOps Platform pipeline'
                checkout scm
            }
        }

        stage('Build Docker Image') {
            steps {
                sh 'docker build -t ${APP_IMAGE} ./app'
            }
        }

        stage('Terraform Init') {
            steps {
                dir('terraform') {
                    sh 'terraform init'
                }
            }
        }

        stage('Terraform Validate') {
            steps {
                dir('terraform') {
                    sh 'terraform validate'
                }
            }
        }

        stage('Terraform Deploy') {
            steps {
                dir('terraform') {
                    sh 'terraform apply -auto-approve'
                }
            }
        }

        stage('Application Health Check') {
            steps {
                sh 'curl --fail http://localhost:5000/health'
            }
        }
    }

    post {
        success {
            echo 'SUCCESS: Application deployed successfully!'
        }

        failure {
            echo 'FAILED: Please check the Jenkins console output.'
        }
    }
}
