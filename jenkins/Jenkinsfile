cd /home/vedhiks/projects/local-devops-platform
cat > Jenkinsfile <<'EOF'
pipeline {
  agent any
  stages {
    stage('Checkout') {
      steps { checkout scm }
    }
    stage('Build Image') {
      steps { sh 'docker build -t local-devops-app:latest .' }
    }
    stage('Deploy') {
      steps {
        sh '''
          docker rm -f local-devops-app || true
          docker run -d --name local-devops-app -p 5000:5000 local-devops-app:latest
        '''
      }
    }
    stage('Verify') {
      steps { sh 'sleep 3 && curl -f http://localhost:5000' }
    }
  }
}
EOF
ls Jenkinsfile Dockerfile